  marker_01_label: { ms: "Kenapa datang", en: "Why visit", zh: "为什么值得来" },
  eyebrow_01: { ms: "Di dalam bingkai yang salah letak", en: "Inside a misaligned frame", zh: "在一个错位的画框里" },
  h2_01_a: { ms: "Rumah kedai yang biasa. ", en: "An ordinary shophouse. ", zh: "寻常的店屋。" },
  h2_01_b: { ms: "Sudut yang mustahil.", en: "Impossible angles.", zh: "不可能的角度。" },
  p_01: { ms: "Muzium ini menyongsangkan sepenuhnya ruang tamu, dapur, ruang makan dan tema yang membawa imej jalanan George Town — rahsianya bukan sekadar perabot yang tergantung di siling, tetapi sudut kamera dan pose yang betul.", en: "The museum fully flips living rooms, kitchens, dining spaces and George Town street-themed scenes — the trick is not just furniture hanging from the ceiling, but the right camera angle and pose.", zh: "这座博物馆把客厅、厨房、餐厅以及融入乔治市街景意象的主题空间，全部彻底倒转布置。诀窍并不只是挂满家具的天花板——更关键的是镜头视角与摆对姿势。" },
  story_room_alt: { ms: "Ruang tamu tematik dengan perabot songsang di dalam muzium", en: "Themed living room with inverted furniture inside the museum", zh: "颠倒博物馆内倒置家具的主题客厅场景" },
  figcaption_01: { ms: "JANGAN TERUS PERCAYA MATA ANDA.", en: "DON'T TRUST WHAT YOU FIRST SEE.", zh: "不要相信你第一眼看到的。" },
  note_a_title: { ms: "Ikut panduan dulu", en: "Follow the guide cards", zh: "跟着示范走" },
  note_a_p: { ms: "Buat beberapa ujian gambar untuk mencari perasaan. Kad rujukan pose disediakan di setiap ruang untuk membantu anda memahami sudut kamera yang paling berkesan.", en: "Take a few test shots first. Reference pose cards in each space help you quickly understand the most effective camera angles.", zh: "先试拍一两张找感觉。每个空间旁都有参考姿势卡，帮助你快速理解最有效果的镜头角度。" },
  note_b_title: { ms: "Pilih waktu yang tepat", en: "Pick the right time", zh: "挑对时间更出片" },
  note_b_p: { ms: "Inginkan latar belakang bersih tanpa orang lalu? Pilih hari bekerja atau awal-awal buka pada jam 09:30. Ruang yang kosong membuatkan ilusi lebih nyata.", en: "Want a clean background with no passers-by? Pick weekdays or the opening hour at 09:30. Empty rooms make the illusion much more convincing.", zh: "想要干净、没有路人的背景？选工作日或刚开门的 09:30 前来。空荡的房间能让视觉错觉更逼真。" },
  note_c_title: { ms: "Jangan terburu-buru", en: "Take your time", zh: "别赶时间，慢慢来" },
  note_c_p: { ms: "Sediakan masa lebih 60 minit. Kakitangan muzium biasanya juga sudi menyarankan pose yang lebih kreatif dan menarik.", en: "Allow more than 60 minutes. Museum staff are usually happy to suggest even more creative poses and compositions.", zh: "建议留出 60 分钟以上。馆内工作人员通常也乐于主动推荐更出片、更有创意的摆位方式。" },
  marker_02_label: { ms: "Sebelum tiba", en: "Before you arrive", zh: "出发前须知" },
  eyebrow_02: { ms: "Maklumat berguna yang boleh diguna terus", en: "Practical info ready to use", zh: "直接可用的实用信息" },
  h2_02_a: { ms: "Bawa hati yang ", en: "Just bring a ", zh: "带上轻松的" },
  h2_02_b: { ms: "senang sahaja.", en: "relaxed mood.", zh: "心情来就好。" },
  p_02: { ms: "Anda tidak perlu susun atur perjalanan yang padat. Sediakan masa satu jam, pakai pakaian yang selesa, kosongkan ruang storan telefon — selebihnya serahkan pada kreativiti dan pelbagai latar songsang.", en: "No need for a packed itinerary. Allocate one hour, wear comfy clothes, free up some phone storage — and leave the rest to creativity and the many upside-down sets.", zh: "不用把这趟行程排得很满。规划一个小时、穿方便活动的衣服、给手机腾点存储空间，剩下就交给创意与各种颠倒场景。" },
  call_button: { ms: "Telefon muzium", en: "Call the museum", zh: "致电博物馆" },
  tickets_aria: { ms: "Yuran kemasukan", en: "Admission tickets", zh: "入场票价" },
  ticket_adult_label: { ms: "DEWASA", en: "ADULT", zh: "成人" },
  ticket_adult_small: { ms: "Yuran rujukan pelawat", en: "Reference visitor price", zh: "访客参考票价" },
  ticket_child_label: { ms: "KANAK-KANAK", en: "CHILD", zh: "儿童" },
  ticket_child_small: { ms: "Yuran rujukan pelawat", en: "Reference visitor price", zh: "访客参考票价" },
  ticket_mykad_label: { ms: "PEMEGANG MyKad", en: "MyKad HOLDERS", zh: "大马卡 MyKad" },
  ticket_mykad_small: { ms: "Dewasa / Kanak-kanak", en: "Adult / Child", zh: "成人 / 儿童" },
  quiet_note: { ms: "Yuran dan waktu operasi mungkin berubah semasa cuti umum atau perayaan. Sebaiknya sahkan melalui telefon sebelum tiba, terutamanya untuk lawatan kumpulan besar.", en: "Ticket prices and opening hours may change on public holidays or festivities. It is best to confirm by phone before visiting, especially for large groups.", zh: "公共假期与节庆期间票价和营业时间可能调整。出发前建议电话确认，尤其是大团体到访。" },
  marker_03_label: { ms: "Cara ke sini", en: "How to get here", zh: "如何抵达" },
  eyebrow_03: { ms: "Bukan tersesat. Cuma arahnya sedikit songsang.", en: "Not lost. Just a little upside down.", zh: "不是迷路。只是方向有点颠倒。" },
  h2_03_a: { ms: "Senang sampai ke ", en: "Easy to reach ", zh: "轻松抵达" },
  h2_03_b: { ms: "Lebuh Kimberley.", en: "Lebuh Kimberley.", zh: "金伯利街。" },
  tr_air_title: { ms: "Dari Lapangan Terbang Antarabangsa Pulau Pinang", en: "From Penang International Airport", zh: "从槟城国际机场出发" },
  tr_air_p: { ms: "Dari Lapangan Terbang Antarabangsa Pulau Pinang (PEN), cara paling terus ialah mengambil teksi atau Grab e-hailing terus ke Lebuh Kimberley, George Town. Perjalanan mengambil masa lebih kurang 30–45 minit, bergantung pada trafik bandar.", en: "From Penang International Airport (PEN), a taxi or Grab e-hailing ride directly to Lebuh Kimberley is the most direct option. Drive time is roughly 30–45 minutes, depending on city traffic.", zh: "从槟城国际机场（PEN, Penang International Airport）前往，计程车或 Grab 网约车最直接到乔治市金伯利街。车程约 30–45 分钟，视市区交通状况而定。" },
  tr_bus_title: { ms: "Bas Rapid Penang", en: "Rapid Penang buses", zh: "快捷通巴士 Rapid Penang" },
  tr_bus_p: { ms: "Naik bas Rapid Penang menuju ke George Town atau Komtar. Setelah turun, sambung dengan berjalan kaki jarak dekat atau Grab jarak pendek. Semak aplikasi rasmi Rapid Penang atau papan bas pada hari lawatan untuk jadual terkini.", en: "Take Rapid Penang heading toward George Town or Komtar. After alighting, continue on foot a short distance or catch a quick Grab ride. Check the official Rapid Penang App or bus stop notice on your travel day for the latest schedule.", zh: "乘坐 Rapid Penang 前往乔治市或 Komtar 光大大厦方向的线路，下车后步行一小段或短程 Grab 衔接即可。出行当天请查看 Rapid Penang 官方 App 或站台信息确认班次。" },
  tr_taxi_title: { ms: "Teksi & e-hailing", en: "Taxis & e-hailing", zh: "计程车 & 网约车" },
  tr_taxi_p: { ms: "Inginkan perkhidmatan pintu ke pintu, pilih teksi meter atau Grab. Lokasinya berada di teras warisan Pulau Pinang; sebutkan alamat penuh atau cari terus \"Upside Down Museum Penang\" dan minta pemandu berhenti betul-betul di hadapan rumah kedai biru.", en: "For door-to-door service, choose metered taxis or Grab. The venue sits inside Penang's heritage core; give the full address or search directly for \"Upside Down Museum Penang\" and ask the driver to stop right in front of the blue shophouse.", zh: "想要门到门服务，选打表计程车或 Grab。地点位于槟城世遗核心区；记得报完整地址或直接搜「Upside Down Museum Penang」，让司机停在蓝色店屋正门口。" },
  tr_walk_title: { ms: "Berjalan kaki dari kawasan warisan", en: "Walk from the heritage quarter", zh: "从世遗区步行" },
  tr_walk_p: { ms: "Jika anda sudah berjalan di kawasan mural Armenian Street, Komtar atau seni jalanan sekitar, muzium ini boleh dimasukkan terus ke laluan jalan kaki anda untuk lawatan warisan George Town seharian.", en: "If you are already walking around Armenian Street murals, Komtar or the nearby street art district, the museum can be folded straight into a walking itinerary for a full George Town heritage day.", zh: "如果你本来就在亚美尼亚街壁画区、Komtar 光大大厦或街头艺术周边散步，博物馆完全可以并入步行路线，串联乔治市世遗一日游。" },
  eyebrow_04_map: { ms: "Titik mula yang betul", en: "The right starting point", zh: "正确的起点" },
  h2_04_map_a: { ms: "Cari rumah kedai biru. ", en: "Find the blue shophouse. ", zh: "找到蓝色店屋。" },
  h2_04_map_b: { ms: "Kemudian songsangkan seluruh hari anda.", en: "Then flip your whole day upside down.", zh: "然后颠倒你的一整天。" },
  map_button: { ms: "Arah di Google Maps", en: "Directions on Google Maps", zh: "在 Google Maps 查看路线" },
  parking_label: { ms: "Letak kereta:", en: "Parking:", zh: "停车：" },
  parking_p: { ms: "Tempat letak kereta di tepi jalan di teras warisan George Town sangat terhad. Sebaiknya gunakan tempat letak kereta awam atau bertingkat berhampiran Komtar, kemudian berjalan kaki atau e-hailing jarak pendek — jimat masa dan lebih tenang.", en: "On-street parking in George Town's heritage core is very scarce. Use public or multi-storey carparks near Komtar, then walk or take a short e-hailing ride — saves time and hassle.", zh: "乔治市世遗核心区路边车位非常紧张。建议使用 Komtar 光大大厦周边公共停车场或多层停车场，再步行或短程电召车到达，省时省心。" },
  iframe_title: { ms: "Peta lokasi Muzium Terbalik George Town, Pulau Pinang", en: "Upside Down Museum location map, George Town Penang", zh: "槟城乔治市颠倒博物馆位置地图" },
  marker_04_label: { ms: "Selepas bergambar", en: "After your visit", zh: "拍完照之后" },
  eyebrow_04a: { ms: "Jalan-jalan yang patut disinggah sepanjang jalan", en: "Worthwhile stops along the way", zh: "值得顺道看看的街道" },
  h2_04a_a: { ms: "Satu jam di dalam muzium. ", en: "One hour inside. ", zh: "一小时在馆内。" },
  h2_04a_b: { ms: "Seharian menjelajah sekitar.", en: "A whole day nearby.", zh: "一整天逛周边。" },
  nearby_food_topline: { ms: "MAKAN", en: "EAT", zh: "美 食" },
  nearby_food_title: { ms: "Selepas bergambar, rasai rasa Pulau Pinang yang sebenar.", en: "After the photos, taste real Penang.", zh: "拍完照，品尝正宗槟城味道。" },
  nearby_food_p: { ms: "Lebuh Kimberley sendiri merupakan lokasi pasar malam makanan yang terkenal di Pulau Pinang. Keluar dari muzium, pusing sedikit sahaja — gerai yang paling ramai orang biasanya yang paling sedap.", en: "Lebuh Kimberley itself is a famous Penang night market food street. Step out of the museum, turn a corner — the most crowded stalls are almost always the most delicious.", zh: "金伯利街本身就是槟城著名的夜市场美食街。从博物馆出来，转个弯就能尝到最地道的槟城街头风味，挑人多的摊位准没错。" },
  food_1: { ms: "Char Kway Teow", en: "Char Kway Teow", zh: "炒粿条 Char Kway Teow" },
  food_2: { ms: "Laksa Assam", en: "Assam Laksa", zh: "亚参叻沙 Assam Laksa" },
  food_3: { ms: "Nasi Kandar", en: "Nasi Kandar", zh: "扁担饭 Nasi Kandar" },
  food_4: { ms: "Pasar malam Lebuh Kimberley", en: "Lebuh Kimberley night market stalls", zh: "金伯利街夜市大排档" },
  nearby_sights_topline: { ms: "JELAJAH", en: "SEE", zh: "景 点" },
  nearby_sights_title: { ms: "Terus jelajahi bandar warisan — tak perlu tergesa-gesa balik hotel.", en: "Continue the heritage walk — no rush back to the hotel.", zh: "接着逛世遗古城，不急着回酒店。" },
  nearby_sights_p: { ms: "Muzium ini terletak betul-betul di teras warisan Pulau Pinang. Berjalan kaki atau e-hailing jarak pendek sahaja untuk menyambung ke mercu tanda budaya utama George Town.", en: "The museum sits right inside Penang's heritage core. A short walk or ride connects you to George Town's most iconic cultural landmarks.", zh: "博物馆所在地恰好位于槟城世遗核心区，步行或短程车即可串联乔治市经典文化地标。" },
  sights_1: { ms: "Mural Armenian Street · Seni Jalanan George Town", en: "Armenian Street murals · George Town street art", zh: "亚美尼亚街壁画 · 乔治市街头艺术" },
  sights_2: { ms: "Khoo Kongsi", en: "Khoo Kongsi clan house", zh: "邱公司 Khoo Kongsi 宗祠" },
  sights_3: { ms: "Menara Tinjau Komtar", en: "Komtar Tower observation deck", zh: "Komtar 光大大厦观景台" },
