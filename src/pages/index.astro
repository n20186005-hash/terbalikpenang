          <a class="text-link" href={mapUrl} target="_blank" rel="noreferrer"><span data-i18n="hero_open_map" data-ms={t.hero_open_map.ms} data-en={t.hero_open_map.en} data-zh={t.hero_open_map.zh}>{t.hero_open_map.ms}</span> <span aria-hidden="true">↗</span></a>
        </div>
        <p class="photo-credit" data-i18n="photo_credit" data-ms={t.photo_credit.ms} data-en={t.photo_credit.en} data-zh={t.photo_credit.zh}>{t.photo_credit.ms}</p>
      </div>
      <div class="hero-visual" data-i18n="hero_visual_aria" data-ms={t.hero_visual_aria.ms} data-en={t.hero_visual_aria.en} data-zh={t.hero_visual_aria.zh} aria-label={t.hero_visual_aria.ms}>
        <div class="poster-stamp"><span data-i18n="poster_stamp_1" data-ms={t.poster_stamp_1.ms} data-en={t.poster_stamp_1.en} data-zh={t.poster_stamp_1.zh}>{t.poster_stamp_1.ms}</span><br /><span data-i18n="poster_stamp_2" data-ms={t.poster_stamp_2.ms} data-en={t.poster_stamp_2.en} data-zh={t.poster_stamp_2.zh}>{t.poster_stamp_2.ms}</span></div>
        <img class="hero-graphic" data-fallback onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=abstract+upside+down+museum+geometric+pattern+indigo+coral+penang+shophouse&image_size=landscape_16_9'" src="/upside-down-museum-abstract-hero.png" alt="" aria-hidden="true" />
        <img class="hero-photo" onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+museum+exterior+blue+shophouse+facade+georgetown+penang+malaysia&image_size=square_hd'" src="/upside-down-museum-exterior.jpg" data-i18n="hero_exterior_alt" data-ms={t.logo_alt.ms} data-en={t.logo_alt.en} data-zh={t.logo_alt.zh} alt={t.logo_alt.ms} />
