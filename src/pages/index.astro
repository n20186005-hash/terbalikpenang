  header_aria_brand: { ms: "Muzium Terbalik · Kembali ke atas", en: "Upside Down Museum · Back to top", zh: "颠倒博物馆 · 返回页首" },
  logo_alt: { ms: "Logo rumah kedai biru terbalik Muzium Terbalik", en: "Upside Down Museum blue inverted shophouse logo", zh: "倒立蓝色店屋颠倒博物馆标志" },
  brand_small: { ms: "Muzium · Pulau Pinang", en: "Museum · Penang", zh: "Museum · 槟城" },
  eyebrow_location: { ms: "George Town · Pulau Pinang", en: "George Town · Penang", zh: "乔治市 · 槟城" },
  hero_title_inner_a: { ms: "Di sini, ", en: "Here, ", zh: "在这里，" },
  hero_title_inner_b: { ms: "lantai pun enggan kekal di bawah", en: "even the floor refuses to stay beneath you", zh: "连地板都不愿待在脚下" },
  hero_intro: { ms: "Masuk ke sebuah rumah kedai tradisional di Lebuh Kimberley, dan lihat semula Pulau Pinang dari sudut yang songsang. Enam ruang tematik, satu memori George Town yang diterbalikkan sepenuhnya — banyak sebab untuk anda memutar skrin telefon.", en: "Step into a traditional shophouse on Lebuh Kimberley and rediscover Penang from an upside-down angle. Six themed rooms, one fully flipped George Town memory — plenty of reasons to rotate your phone screen.", zh: "走进金伯利街（Lebuh Kimberley）一间传统老店屋，用颠倒的视角重新看槟城。六大主题空间，一条完全翻转的乔治市记忆，给你无数旋转手机屏幕的理由。" },
  hero_plan: { ms: "Rancang lawatan", en: "Plan your visit", zh: "规划行程" },
  hero_open_map: { ms: "Buka peta", en: "Open map", zh: "打开地图" },
