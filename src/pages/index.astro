---
/**
 * Design reminder: “Graviti songsang, poster Nyonya” — real museum photos carry
 * the story; coral route marks and inverted shophouse geometry carry the interface.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const placeName = "Upside Down Museum";
const address = "45, Lebuh Kimberley, George Town, 10100 George Town, Pulau Pinang, Malaysia";
const mapUrl = "https://www.google.com/maps/search/?api=1&query=45%2C%20Lebuh%20Kimberley%2C%20George%20Town%2C%2010100%20George%20Town%2C%20Pulau%20Pinang%2C%20Malaysia";
const callUrl = "tel:+6042642660";
const pageURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

const attractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: placeName,
  ...(pageURL ? { url: pageURL } : {}),
  description: "Muzium interaktif di George Town dengan bilik dan objek yang mencipta ilusi dunia terbalik untuk pengalaman fotografi.",
  image: Astro.site ? new URL("/manus-storage/upside-down-museum-exterior_be70b49d.jpg", Astro.site).toString() : undefined,
  address: { "@type": "PostalAddress", streetAddress: "45, Lebuh Kimberley", addressLocality: "George Town", postalCode: "10100", addressRegion: "Pulau Pinang", addressCountry: "MY" },
  geo: { "@type": "GeoCoordinates", latitude: 5.4158046, longitude: 100.3335296 },
  telephone: "+60 4-264 2660",
  openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], opens: "09:30", closes: "18:30" }],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.2", reviewCount: "5819", bestRating: "5" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "Berapa lama masa yang sesuai untuk melawat?", acceptedAnswer: { "@type": "Answer", text: "Kebanyakan pengunjung boleh merancang sekitar satu jam untuk meneroka ruang dan mengambil foto. Datang pada waktu kurang sibuk jika anda mahu lebih banyak ruang untuk bergambar." } },
    { "@type": "Question", name: "Adakah fotografi dibenarkan?", acceptedAnswer: { "@type": "Answer", text: "Ya. Pengalaman di muzium ini direka untuk fotografi ilusi. Semak arahan kakitangan di setiap ruang dan jaga giliran pengunjung lain." } },
    { "@type": "Question", name: "Bagaimana cara paling mudah dari Lapangan Terbang Antarabangsa Pulau Pinang?", acceptedAnswer: { "@type": "Answer", text: "Pilihan paling terus ialah teksi atau e-hailing ke Lebuh Kimberley. Untuk pilihan lebih jimat, naik bas ke kawasan Komtar atau pusat George Town dan sambung dengan berjalan kaki atau e-hailing jarak dekat." } },
    { "@type": "Question", name: "Adakah terdapat parkir di muzium?", acceptedAnswer: { "@type": "Answer", text: "Parkir tepi jalan di pusat George Town adalah terhad. Gunakan parkir awam atau parkir bertingkat sekitar Komtar dan teruskan berjalan kaki atau dengan e-hailing jarak dekat." } }
  ]
};
---

<BaseLayout title="Upside Down Museum — George Town, Pulau Pinang" description="Panduan lawatan praktikal ke Upside Down Museum di Lebuh Kimberley: tiket, waktu, pengangkutan, parkir, makanan dan tempat sekitar." >
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <header class="site-header" id="atas">
    <a class="brand" href="#atas" aria-label="Upside Down Museum — kembali ke atas"><img src="/manus-storage/upside-down-museum-logo_b5f71d4f.png" alt="Lambang rumah kedai terbalik" width="48" height="48" /><span><strong>Upside Down</strong><small>Museum · Penang</small></span></a>
    <nav aria-label="Navigasi utama"><a href="#pengalaman">Pengalaman</a><a href="#rancang">Rancang</a><a href="#sekitar">Sekitar</a><a href="#soalan">Soalan</a></nav>
    <a class="header-pin" href={mapUrl} target="_blank" rel="noreferrer">45 Lebuh Kimberley <span aria-hidden="true">↗</span></a>
  </header>
  <main>
    <section class="hero" aria-labelledby="tajuk-hero">
      <div class="hero-copy"><p class="eyebrow"><span></span> George Town · Pulau Pinang</p><h1 id="tajuk-hero">Di sini, lantai pun <em>enggan</em> kekal di bawah.</h1><p class="hero-intro">Masuk ke rumah kedai lama di Lebuh Kimberley, kemudian balikkan cara anda melihatnya. Enam ruang, satu jalan George Town yang songsang, dan banyak alasan untuk memusingkan skrin kamera.</p><div class="hero-actions"><a class="button button-coral" href="#rancang">Rancang lawatan <span aria-hidden="true">↓</span></a><a class="text-link" href={mapUrl} target="_blank" rel="noreferrer">Buka peta <span aria-hidden="true">↗</span></a></div><p class="photo-credit">Gambar lawatan digunakan sebagai rujukan visual tempat sebenar.</p></div>
      <div class="hero-visual" aria-label="Pintu masuk Upside Down Museum di Lebuh Kimberley"><div class="poster-stamp">SEJAK<br />2015</div><img class="hero-graphic" src="/manus-storage/upside-down-museum-abstract-hero_323b5e0e.png" alt="" aria-hidden="true" /><img class="hero-photo" src="/manus-storage/upside-down-museum-exterior_be70b49d.jpg" alt="Fasad biru Upside Down Museum di Lebuh Kimberley" /><p class="image-note">PINTU MASUK · LEBUH KIMBERLEY</p><div class="corner-frame" aria-hidden="true"></div></div>
      <div class="hero-facts" aria-label="Maklumat utama"><div><span>WAKTU</span><strong>09:30–18:30</strong><small>Setiap hari · masuk akhir 17:45</small></div><div><span>DARI</span><strong>RM36</strong><small>Dewasa · kanak-kanak RM26</small></div><div><span>GALERI</span><strong>4.2 / 5</strong><small>5,819 ulasan Google Maps</small></div></div>
    </section>
    <div class="poster-break" aria-hidden="true"><span>↘</span><span>↗</span><span>↘</span></div>
    <section class="story-section section-wrap" id="pengalaman" aria-labelledby="tajuk-pengalaman"><div class="section-marker"><span>01</span><i></i><span>Kenapa datang</span></div><div class="story-layout"><div class="story-heading"><p class="eyebrow"><span></span> Dalam bingkai yang salah</p><h2 id="tajuk-pengalaman">Rumah biasa. Sudut yang <em>mustahil.</em></h2><p>Muzium ini menyusun ruang rumah, dapur, ruang makan dan set berinspirasikan George Town dalam keadaan terbalik. Rahsianya bukan sekadar siling yang penuh perabot — ia ialah sudut pandang kamera dan pose yang tepat.</p></div><figure class="tilt-photo photo-room"><img src="/manus-storage/upside-down-museum-room_4572adda.jpg" alt="Ruang dalaman Upside Down Museum dengan perabot yang terbalik" loading="lazy" /><figcaption>JANGAN TERUS PERCAYA MATA ANDA.</figcaption></figure><div class="story-notes"><article><span class="note-number">A</span><h3>Ikut tanda</h3><p>Mulakan dengan satu atau dua foto percubaan. Contoh pose di ruang membantu anda memahami arah kamera.</p></article><article><span class="note-number">B</span><h3>Ruang untuk foto</h3><p>Jika anda mahu latar yang bersih, pilih hari biasa atau datang lebih awal. Bilik kosong memberi ilusi yang lebih meyakinkan.</p></article><article><span class="note-number">C</span><h3>Jangan terburu-buru</h3><p>Simpan kira-kira satu jam. Kakitangan biasanya boleh mencadangkan posisi yang menjadikan hasil lebih menjadi.</p></article></div></div></section>
    <section class="tickets-section" id="rancang" aria-labelledby="tajuk-rancang"><div class="section-wrap"><div class="section-marker light"><span>02</span><i></i><span>Sebelum tiba</span></div><div class="tickets-layout"><div class="tickets-copy"><p class="eyebrow light"><span></span> Maklumat yang terus berguna</p><h2 id="tajuk-rancang">Datang dengan rancangan yang <em>ringan.</em></h2><p>Tiada keperluan untuk menjadikan lawatan ini panjang. Rancang satu jam, pakai pakaian yang membolehkan anda bergerak dan bawa telefon dengan ruang kosong untuk banyak percubaan foto.</p><a class="button button-paper" href={callUrl}>Hubungi muzium <span aria-hidden="true">↗</span></a></div><div class="ticket-list" aria-label="Yuran kemasukan"><div class="ticket-row"><span>DEWASA</span><strong>RM36</strong><small>Harga rujukan pelawat</small></div><div class="ticket-row"><span>KANAK-KANAK</span><strong>RM26</strong><small>Harga rujukan pelawat</small></div><div class="ticket-row"><span>MYKAD</span><strong>RM26 / RM14</strong><small>Dewasa / kanak-kanak</small></div><p class="quiet-note">Harga dan waktu boleh berubah pada cuti umum. Sahkan melalui telefon sebelum berangkat, terutama jika anda datang dalam kumpulan.</p></div></div></div><img class="inverted-city" src="/manus-storage/upside-down-museum-pattern_17bb7306.png" alt="" aria-hidden="true" /></section>
    <section class="route-section section-wrap" aria-labelledby="tajuk-ke-sini"><div class="route-art" aria-hidden="true"><img src="/manus-storage/upside-down-museum-route-art_8591e0c2.png" alt="" loading="lazy" /></div><div class="route-copy"><div class="section-marker"><span>03</span><i></i><span>Cara ke sini</span></div><p class="eyebrow"><span></span> Bukan sesat. Cuma terbalik sedikit.</p><h2 id="tajuk-ke-sini">Sampai ke Lebuh Kimberley <em>tanpa drama.</em></h2><div class="transport-list"><article><div class="transport-icon" aria-hidden="true">✈</div><div><h3>Dari lapangan terbang</h3><p>Dari Lapangan Terbang Antarabangsa Pulau Pinang, teksi atau e-hailing ialah pilihan paling terus ke pusat George Town. Masa perjalanan bergantung pada trafik; tetapkan destinasi sebagai <strong>{placeName}</strong>, bukan hanya “Kimberley Street”.</p></div></article><article><div class="transport-icon" aria-hidden="true">▰</div><div><h3>Bas awam</h3><p>Naik bas Rapid Penang menuju kawasan George Town atau Komtar, kemudian sambung dengan berjalan kaki atau e-hailing jarak dekat. Semak aplikasi atau papan maklumat Rapid Penang pada hari perjalanan kerana laluan boleh berubah.</p></div></article><article><div class="transport-icon" aria-hidden="true">▱</div><div><h3>Teksi & e-hailing</h3><p>Untuk pintu-ke-pintu, pilih teksi berlesen atau e-hailing. Lokasi berada di tengah kawasan warisan; berikan alamat penuh supaya pemandu berhenti di hadapan pintu biru muzium.</p></div></article><article><div class="transport-icon" aria-hidden="true">↗</div><div><h3>Berjalan kaki</h3><p>Jika anda sudah menjelajah Armenian Street, Komtar atau kawasan seni jalanan, muzium ini mudah digabungkan dalam laluan pejalan kaki di pusat George Town.</p></div></article></div></div></section>
    <section class="map-section" aria-labelledby="tajuk-peta"><div class="map-copy"><p class="eyebrow"><span></span> Titik mula yang betul</p><h2 id="tajuk-peta">Cari pintu biru. <em>Kemudian terbalikkan hari anda.</em></h2><address>{address}</address><div class="map-links"><a class="button button-coral" href={mapUrl} target="_blank" rel="noreferrer">Arah di Google Maps <span aria-hidden="true">↗</span></a><a class="text-link dark-link" href={callUrl}>+60 4-264 2660</a></div><div class="parking-note"><span aria-hidden="true">P</span><p><strong>Parkir:</strong> Parkir tepi jalan di pusat bandar sangat terhad. Cari parkir awam atau parkir bertingkat sekitar Komtar, kemudian teruskan dengan berjalan kaki atau e-hailing jarak dekat.</p></div></div><div class="map-frame"><iframe title="Lokasi Upside Down Museum di George Town" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6863.09126941932!2d100.33095467685541!3d5.4158099350396585!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x304ac3915052f02d%3A0x900a2ffb9751a750!2sUpside%20Down%20Museum!5e1!3m2!1sms!2smy!4v1786953660255!5m2!1sms!2smy" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
    <section class="nearby-section" id="sekitar" aria-labelledby="tajuk-sekitar"><div class="section-wrap"><div class="nearby-heading"><div class="section-marker"><span>04</span><i></i><span>Selepas bergambar</span></div><p class="eyebrow"><span></span> Jalan yang patut dilihat</p><h2 id="tajuk-sekitar">Satu jam di dalam. <em>Seharian di sekeliling.</em></h2></div><div class="nearby-columns"><article class="nearby-block food-block"><div class="block-topline"><span>MAKAN</span><span aria-hidden="true">✳</span></div><h3>Selepas foto, cari rasa sebenar Penang.</h3><p>Lebuh Kimberley terkenal dengan suasana makanan jalanan pada waktu malam. Gunakan ia sebagai hentian selepas muzium dan pilih gerai yang sedang sibuk untuk makan malam santai.</p><ul><li>Char kway teow</li><li>Assam laksa</li><li>Nasi kandar</li><li>Kimberley Street Food Night Market</li></ul></article><article class="nearby-block sights-block"><div class="block-topline"><span>JELAJAH</span><span aria-hidden="true">↗</span></div><h3>Sambung ke bandar lama, bukan terus ke hotel.</h3><p>Lokasi ini berada dalam kawasan yang padat dengan seni jalanan, rumah kedai dan cerita komuniti George Town.</p><ul><li>Armenian Street & mural</li><li>Khoo Kongsi</li><li>Komtar</li><li>Cheong Fatt Tze — The Blue Mansion</li></ul></article><figure class="nearby-photo"><img src="/manus-storage/upside-down-museum-interior_b658336c.jpg" alt="Set dalaman yang terbalik di Upside Down Museum" loading="lazy" /><figcaption>FOTO YANG BAIK BERMULA DENGAN SUDUT YANG SALAH.</figcaption></figure></div></div></section>
    <section class="faq-section section-wrap" id="soalan" aria-labelledby="tajuk-soalan"><div class="faq-intro"><div class="section-marker"><span>05</span><i></i><span>Soalan lazim</span></div><p class="eyebrow"><span></span> Sebelum anda putar kamera</p><h2 id="tajuk-soalan">Jawapan pendek untuk <em>hari yang panjang.</em></h2><img src="/manus-storage/upside-down-museum-group_43c8c9be.jpg" alt="Pengunjung bergambar dalam ruang Upside Down Museum" loading="lazy" /></div><div class="faq-list"><details open><summary>Berapa lama masa yang sesuai untuk melawat?<span>+</span></summary><p>Rancang sekitar satu jam untuk meneroka ruang dan mengambil foto. Datang pada waktu kurang sibuk jika anda mahu lebih banyak ruang untuk bergambar.</p></details><details><summary>Adakah fotografi dibenarkan?<span>+</span></summary><p>Ya. Pengalaman ini direka untuk fotografi ilusi. Semak arahan kakitangan di setiap ruang dan jaga giliran pengunjung lain.</p></details><details><summary>Perlukah beli tiket lebih awal?<span>+</span></summary><p>Pra-tempahan lazimnya tidak diperlukan, tetapi menghubungi muzium terlebih dahulu adalah pilihan bijak untuk kumpulan atau musim cuti.</p></details><details><summary>Adakah sesuai untuk kanak-kanak?<span>+</span></summary><p>Ya, tetapi kanak-kanak perlu diawasi oleh penjaga ketika bergerak dan bergambar di dalam set pameran.</p></details><details><summary>Bagaimana dengan hujan di George Town?<span>+</span></summary><p>Muzium ialah pilihan dalaman yang sesuai ketika hujan atau cuaca tengah hari yang panas. Rancang laluan dari titik turun kenderaan ke pintu masuk terlebih dahulu.</p></details></div></section>
    <section class="closing-section"><img class="closing-pattern" src="/manus-storage/upside-down-museum-pattern_17bb7306.png" alt="" aria-hidden="true" /><div class="closing-copy"><p class="eyebrow light"><span></span> Satu nota terakhir</p><h2>Rancang satu jam. Pulang dengan galeri yang <em>terbalik.</em></h2><a class="button button-paper" href={mapUrl} target="_blank" rel="noreferrer">Mulakan perjalanan <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <footer><a class="brand footer-brand" href="#atas" aria-label="Kembali ke atas"><img src="/manus-storage/upside-down-museum-logo_b5f71d4f.png" alt="" width="42" height="42" /><span><strong>Upside Down</strong><small>Museum · Penang</small></span></a><p>Ini ialah panduan pelawat tidak rasmi dan bukan laman web yang dikendalikan oleh Upside Down Museum. Sahkan maklumat lawatan dengan pihak muzium sebelum berangkat.</p><a href="#atas">Ke atas ↑</a></footer>
</BaseLayout>
