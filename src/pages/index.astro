---
/**
 * Design reminder: “Graviti songsang, poster Nyonya” — real museum photos carry
 * the story; coral route marks and inverted shophouse geometry carry the interface.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const placeName = "Upside Down Museum Penang";
const address = "45, Lebuh Kimberley, George Town, 10100 George Town, Pulau Pinang, Malaysia";
const mapUrl = "https://maps.app.goo.gl/gk7T76pQTtcqWbXBA";
const callUrl = "tel:+6042642660";
const pageURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

const imageFallback = "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+museum+georgetown+penang+shophouse+interior+inverted+rooms+nyonya+colors&image_size=square_hd";

const attractionSchema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: "颠倒博物馆（Upside Down Museum Penang）",
  ...(pageURL ? { url: pageURL } : {}),
  description: "马来西亚槟城乔治市世遗区互动式颠倒错觉博物馆，设在传统店屋内，多间倒置主题空间与本地娘惹风格布景，打造趣味创意摄影体验。",
  image: Astro.site ? new URL("/upside-down-museum-exterior.jpg", Astro.site).toString() : imageFallback,
  address: { "@type": "PostalAddress", streetAddress: "45, Lebuh Kimberley（金伯利街）", addressLocality: "乔治市（George Town）", postalCode: "10100", addressRegion: "槟城（Pulau Pinang）", addressCountry: "MY" },
  geo: { "@type": "GeoCoordinates", latitude: 5.4158046, longitude: 100.3335296 },
  telephone: "+60 4-264 2660",
  openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], opens: "09:30", closes: "18:30" }],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.2", reviewCount: "5819", bestRating: "5" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "建议预留多长时间参观槟城颠倒博物馆？", acceptedAnswer: { "@type": "Answer", text: "建议预留约 1 小时逛完展区并拍照。如果想避开人群拍出干净背景，可选择工作日非高峰时段前来。" } },
    { "@type": "Question", name: "馆内允许拍照和录像吗？", acceptedAnswer: { "@type": "Answer", text: "允许，整座博物馆就是为错觉摄影体验而专门设计。每个空间旁都有示范姿势卡，帮助快速找到最出片的角度。" } },
    { "@type": "Question", name: "从槟城国际机场如何前往颠倒博物馆？", acceptedAnswer: { "@type": "Answer", text: "从槟城国际机场（PEN）出发，最直接的方式是搭乘计程车或 Grab 网约车直达金伯利街。车程约 30–45 分钟，视市区交通而定。" } },
    { "@type": "Question", name: "博物馆附近停车方便吗？", acceptedAnswer: { "@type": "Answer", text: "乔治市世遗核心区路边车位非常紧张，建议使用 Komtar 周边公共停车场或多层停车场，再步行或短程电召车到达。" } }
  ]
};
---

<BaseLayout title="颠倒博物馆 — 马来西亚槟城乔治市" description="槟城乔治市金伯利街颠倒博物馆实用游客指南：门票令吉价格、开放时间、交通方式、停车信息、街头美食与周边世遗景点。" >
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script define:vars={{ fallback: imageFallback }} is:inline>
  window.__imgFallback = window.__imgFallback || document.currentScript.dataset.fallback || "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+museum+georgetown+penang+shophouse+inverted+rooms+nyonya+colors&image_size=square_hd";
  </script>
  <header class="site-header" id="atas">
    <a class="brand" href="#atas" aria-label="颠倒博物馆 · 返回页首"><img data-fallback src="/upside-down-museum-logo.png" onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+museum+logo+blue+shophouse+inverted+roof+penang&image_size=square'" alt="倒立蓝色店屋颠倒博物馆标志" width="48" height="48" /><span><strong>Upside Down</strong><small>Museum · 槟城</small></span></a>
    <nav aria-label="主导航"><a href="#pengalaman">景点概览</a><a href="#rancang">出行规划</a><a href="#sekitar">周边推荐</a><a href="#soalan">常见问题</a></nav>
    <a class="header-pin" href={mapUrl} target="_blank" rel="noreferrer">45 金伯利街 <span aria-hidden="true">↗</span></a>
  </header>
  <main>
    <section class="hero" aria-labelledby="tajuk-hero">
      <div class="hero-copy"><p class="eyebrow"><span></span> 乔治市 · 槟城</p><h1 id="tajuk-hero">在这里，<em>连地板</em>都不愿待在脚下。</h1><p class="hero-intro">走进金伯利街（Lebuh Kimberley）一间传统老店屋，用颠倒的视角重新看槟城。六大主题空间，一条完全翻转的乔治市记忆，给你无数旋转手机屏幕的理由。</p><div class="hero-actions"><a class="button button-coral" href="#rancang">规划行程 <span aria-hidden="true">↓</span></a><a class="text-link" href={mapUrl} target="_blank" rel="noreferrer">打开地图 <span aria-hidden="true">↗</span></a></div><p class="photo-credit">馆内图片仅作为真实场景的视觉参考。</p></div>
      <div class="hero-visual" aria-label="槟城金伯利街颠倒博物馆入口外观"><div class="poster-stamp">始创<br />2015</div><img class="hero-graphic" data-fallback onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=abstract+upside+down+museum+geometric+pattern+indigo+coral+penang+shophouse&image_size=landscape_16_9'" src="/upside-down-museum-abstract-hero.png" alt="" aria-hidden="true" /><img class="hero-photo" onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+museum+exterior+blue+shophouse+facade+georgetown+penang+malaysia&image_size=square_hd'" src="/upside-down-museum-exterior.jpg" alt="槟城金伯利街颠倒博物馆蓝色店屋外墙外观" /><p class="image-note">博物馆入口 · 金伯利街</p><div class="corner-frame" aria-hidden="true"></div></div>
      <div class="hero-facts" aria-label="核心信息"><div><span>开放时间</span><strong>09:30–18:30</strong><small>每日开放 · 最晚入场 17:45</small></div><div><span>票价起</span><strong>RM36</strong><small>成人 · 儿童 RM26</small></div><div><span>游客评分</span><strong>4.2 / 5</strong><small>5,819 则 Google Maps 评价</small></div></div>
    </section>
    <div class="poster-break" aria-hidden="true"><span>↘</span><span>↗</span><span>↘</span></div>
    <section class="story-section section-wrap" id="pengalaman" aria-labelledby="tajuk-pengalaman"><div class="section-marker"><span>01</span><i></i><span>为什么值得来</span></div><div class="story-layout"><div class="story-heading"><p class="eyebrow"><span></span> 在一个错位的画框里</p><h2 id="tajuk-pengalaman">寻常的店屋。<em>不可能的</em>角度。</h2><p>这座博物馆把客厅、厨房、餐厅以及融入乔治市街景意象的主题空间，全部彻底倒转布置。诀窍并不只是挂满家具的天花板——更关键的是镜头视角与摆对姿势。</p></div><figure class="tilt-photo photo-room"><img onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+museum+room+with+inverted+furniture+nyonya+style+living+room&image_size=portrait_4_3'" src="/upside-down-museum-room.jpg" alt="颠倒博物馆内倒置家具的主题客厅场景" loading="lazy" /><figcaption>不要相信你第一眼看到的。</figcaption></figure><div class="story-notes"><article><span class="note-number">A</span><h3>跟着示范走</h3><p>先试拍一两张找感觉。每个空间旁都有参考姿势卡，帮助你快速理解最有效果的镜头角度。</p></article><article><span class="note-number">B</span><h3>挑对时间更出片</h3><p>想要干净、没有路人的背景？选工作日或刚开门的 09:30 前来。空荡的房间能让视觉错觉更逼真。</p></article><article><span class="note-number">C</span><h3>别赶时间，慢慢来</h3><p>建议留出 60 分钟以上。馆内工作人员通常也乐于主动推荐更出片、更有创意的摆位方式。</p></article></div></div></section>
    <section class="tickets-section" id="rancang" aria-labelledby="tajuk-rancang"><div class="section-wrap"><div class="section-marker light"><span>02</span><i></i><span>出发前须知</span></div><div class="tickets-layout"><div class="tickets-copy"><p class="eyebrow light"><span></span> 直接可用的实用信息</p><h2 id="tajuk-rancang">带上轻松的<em>心情</em>来就好。</h2><p>不用把这趟行程排得很满。规划一个小时、穿方便活动的衣服、给手机腾点存储空间，剩下就交给创意与各种颠倒场景。</p><a class="button button-paper" href={callUrl}>致电博物馆 <span aria-hidden="true">↗</span></a></div><div class="ticket-list" aria-label="入场票价"><div class="ticket-row"><span>成人</span><strong>RM36</strong><small>访客参考票价</small></div><div class="ticket-row"><span>儿童</span><strong>RM26</strong><small>访客参考票价</small></div><div class="ticket-row"><span>大马卡 MyKad</span><strong>RM26 / RM14</strong><small>成人 / 儿童</small></div><p class="quiet-note">公共假期与节庆期间票价和营业时间可能调整。出发前建议电话确认，尤其是大团体到访。</p></div></div></div><img class="inverted-city" onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+georgetown+penang+shophouse+silhouette+heritage+pattern+indigo&image_size=landscape_16_9'" src="/upside-down-museum-pattern.png" alt="" aria-hidden="true" /></section>
    <section class="route-section section-wrap" aria-labelledby="tajuk-ke-sini"><div class="route-art" aria-hidden="true"><img onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=route+map+illustration+georgetown+penang+heritage+streets+coral+lines&image_size=portrait_4_3'" src="/upside-down-museum-route-art.png" alt="" loading="lazy" /></div><div class="route-copy"><div class="section-marker"><span>03</span><i></i><span>如何抵达</span></div><p class="eyebrow"><span></span> 不是迷路。只是方向有点颠倒。</p><h2 id="tajuk-ke-sini">轻松抵达<em>金伯利街</em>。</h2><div class="transport-list"><article><div class="transport-icon" aria-hidden="true">✈</div><div><h3>从槟城国际机场出发</h3><p>从槟城国际机场（PEN, Penang International Airport）前往，计程车或 Grab 网约车最直接到乔治市金伯利街。车程约 30–45 分钟，视市区交通状况而定。</p></div></article><article><div class="transport-icon" aria-hidden="true">▰</div><div><h3>快捷通巴士 Rapid Penang</h3><p>乘坐 Rapid Penang 前往乔治市或 Komtar 光大大厦方向的线路，下车后步行一小段或短程 Grab 衔接即可。出行当天请查看 Rapid Penang 官方 App 或站台信息确认班次。</p></div></article><article><div class="transport-icon" aria-hidden="true">▱</div><div><h3>计程车 & 网约车</h3><p>想要门到门服务，选打表计程车或 Grab。地点位于槟城世遗核心区；记得报完整地址或直接搜「Upside Down Museum Penang」，让司机停在蓝色店屋正门口。</p></div></article><article><div class="transport-icon" aria-hidden="true">↗</div><div><h3>从世遗区步行</h3><p>如果你本来就在亚美尼亚街壁画区、Komtar 光大大厦或街头艺术周边散步，博物馆完全可以并入步行路线，串联乔治市世遗一日游。</p></div></article></div></div></section>
    <section class="map-section" aria-labelledby="tajuk-peta"><div class="map-copy"><p class="eyebrow"><span></span> 正确的起点</p><h2 id="tajuk-peta">找到蓝色店屋。<em>然后颠倒你的一整天。</em></h2><address>{address}</address><div class="map-links"><a class="button button-coral" href={mapUrl} target="_blank" rel="noreferrer">在 Google Maps 查看路线 <span aria-hidden="true">↗</span></a><a class="text-link dark-link" href={callUrl}>+60 4-264 2660</a></div><div class="parking-note"><span aria-hidden="true">P</span><p><strong>停车：</strong>乔治市世遗核心区路边车位非常紧张。建议使用 Komtar 光大大厦周边公共停车场或多层停车场，再步行或短程电召车到达，省时省心。</p></div></div><div class="map-frame"><iframe title="槟城乔治市颠倒博物馆位置地图" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6863.09126941932!2d100.33095467685541!3d5.4158099350396585!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x304ac3915052f02d%3A0x900a2ffb9751a750!2sUpside%20Down%20Museum!5e1!3m2!1szh-CN!2smy!4v1786953660255!5m2!1szh-CN!2smy" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
    <section class="nearby-section" id="sekitar" aria-labelledby="tajuk-sekitar"><div class="section-wrap"><div class="nearby-heading"><div class="section-marker"><span>04</span><i></i><span>拍完照之后</span></div><p class="eyebrow"><span></span> 值得顺道看看的街道</p><h2 id="tajuk-sekitar">一小时在馆内。<em>一整天</em>逛周边。</h2></div><div class="nearby-columns"><article class="nearby-block food-block"><div class="block-topline"><span>美 食</span><span aria-hidden="true">✳</span></div><h3>拍完照，品尝正宗槟城味道。</h3><p>金伯利街本身就是槟城著名的夜市场美食街。从博物馆出来，转个弯就能尝到最地道的槟城街头风味，挑人多的摊位准没错。</p><ul><li>炒粿条 Char Kway Teow</li><li>亚参叻沙 Assam Laksa</li><li>扁担饭 Nasi Kandar</li><li>金伯利街夜市大排档</li></ul></article><article class="nearby-block sights-block"><div class="block-topline"><span>景 点</span><span aria-hidden="true">↗</span></div><h3>接着逛世遗古城，不急着回酒店。</h3><p>博物馆所在地恰好位于槟城世遗核心区，步行或短程车即可串联乔治市经典文化地标。</p><ul><li>亚美尼亚街壁画 · 乔治市街头艺术</li><li>邱公司 Khoo Kongsi 宗祠</li><li>Komtar 光大大厦观景台</li><li>张弼士故居 Cheong Fatt Tze 蓝屋</li></ul></article><figure class="nearby-photo"><img onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=upside+down+museum+inverted+kitchen+room+nyonya+style+people+posing+for+photo&image_size=portrait_4_3'" src="/upside-down-museum-interior.jpg" alt="颠倒博物馆倒置娘惹风格厨房场景内游客摆拍" loading="lazy" /><figcaption>好照片，往往从一个错误的角度开始。</figcaption></figure></div></div></section>
    <section class="faq-section section-wrap" id="soalan" aria-labelledby="tajuk-soalan"><div class="faq-intro"><div class="section-marker"><span>05</span><i></i><span>常见问题</span></div><p class="eyebrow"><span></span> 在翻转镜头之前</p><h2 id="tajuk-soalan">给<em>整天行程</em>的简短回答。</h2><img onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=family+visiting+upside+down+museum+penang+posing+in+inverted+room+colorful&image_size=square_hd'" src="/upside-down-museum-group.jpg" alt="家庭游客在槟城颠倒博物馆倒置房间内合影" loading="lazy" /></div><div class="faq-list"><details open><summary>建议预留多长时间参观？<span>+</span></summary><p>建议约 1 小时从容逛完展区并拍照。如果想避开人群、拍出干净的背景，推荐工作日或上午时段前往。</p></details><details><summary>馆内允许拍照吗？<span>+</span></summary><p>允许，整座博物馆本来就是为错觉摄影体验而设计的。每个空间旁都有示范姿势卡可以参考，记得给手机留够存储空间。</p></details><details><summary>需要提前购票吗？<span>+</span></summary><p>一般散客通常无需提前订票。如果是学校团体、公司团建，或正逢学校假期/公共假期旺季，建议提前致电确认档期更稳妥。</p></details><details><summary>适合带小朋友去吗？<span>+</span></summary><p>非常适合家庭出游。不过小朋友在展区布景上走动或摆拍时，请家长全程陪同留意，确保大家安全。</p></details><details><summary>遇到乔治市下雨怎么办？<span>+</span></summary><p>博物馆本身就是室内景点，下雨或午后炎热天气里都非常合适。建议提前规划好从下车点到馆门口的步行路线，减少在户外日晒雨淋的时间。</p></details></div></section>
    <section class="closing-section"><img class="closing-pattern" onerror="this.onerror=null;this.src='https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=inverted+georgetown+penang+shophouse+skyline+pattern+ink+texture&image_size=landscape_16_9'" src="/upside-down-museum-pattern.png" alt="" aria-hidden="true" /><div class="closing-copy"><p class="eyebrow light"><span></span> 最后一个小提示</p><h2>计划一小时。<em>带回一整辑</em>颠倒的照片。</h2><a class="button button-paper" href={mapUrl} target="_blank" rel="noreferrer">开启旅程 <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <footer class="site-footer">
    <div class="footer-grid section-wrap">
      <div class="footer-brand-col">
        <a class="brand footer-brand" href="#atas" aria-label="返回页首"><img src="/upside-down-museum-logo.png" alt="" width="42" height="42" /><span><strong>Upside Down</strong><small>Museum · 槟城</small></span></a>
        <p class="footer-nonprofit">本网站为一个独立的非营利游客信息指南项目，与任何政府机构或官方组织均无隶属关系。</p>
        <p class="footer-sources">本站景点信息均参考并对照考证自<strong>槟岛市政厅（Penang Island City Council, Majlis Bandaraya Pulau Pinang）</strong>、<strong>槟城旅游局（Penang Global Tourism）</strong>与<strong>马来西亚旅游、艺术与文化部（Ministry of Tourism, Arts &amp; Culture Malaysia, MOTAC）</strong>公开资料，不包含任何商业性推荐。</p>
      </div>
      <div class="footer-links-col">
        <p class="footer-heading">法律信息</p>
        <nav class="footer-nav" aria-label="法律页面导航">
          <a href="/privacy">隐私政策</a>
          <a href="/terms">服务条款</a>
          <a href="/cookies">Cookie 设置</a>
        </nav>
        <p class="footer-copyright">© 2026 Upside Down Museum Guide。保留所有权利。</p>
      </div>
      <div class="footer-image-col">
        <p class="footer-heading">图片产权声明</p>
        <p class="footer-image-note">本网站所展示的所有图片产权及版权均归原摄影者所有。图片主要通过 Unsplash 开放图库授权使用，另有部分来自贡献者署名授权。</p>
        <a class="footer-to-top" href="#atas">回到顶部 ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>
