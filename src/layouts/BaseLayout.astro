---
/**
 * Design reminder: “Graviti songsang, poster Nyonya” — deep indigo ink,
 * coral route marks, warm paper and real Penang photography; never generic UI.
 */
import "../styles/global.css";

interface Props {
  titleMs: string;
  titleEn: string;
  titleZh: string;
  descMs: string;
  descEn: string;
  descZh: string;
  image?: string;
  noindex?: boolean;
}

const { titleMs, titleEn, titleZh, descMs, descEn, descZh, image = "/upside-down-museum-exterior.jpg", noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL(image, Astro.site) : undefined;
// 服务端默认（爬虫看到的）语言设为英文：Search Console 数据显示英文查询占绝对多数，
// 改为英文默认可提升英文搜索片段的 CTR；真实访客仍由前端按浏览器语言自动协商。
const defaultLang = "en";
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173B63" />
    <meta name="description" data-i18n="meta_description" data-ms={descMs} data-en={descEn} data-zh={descZh} content={descEn} />
    {canonical && <link rel="canonical" href={canonical.toString()} />}
    {canonical && (
      <>
        <link rel="alternate" hreflang="en" href={canonical.toString()} />
        <link rel="alternate" hreflang="ms" href={canonical.toString()} />
        <link rel="alternate" hreflang="zh" href={canonical.toString()} />
        <link rel="alternate" hreflang="x-default" href={canonical.toString()} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Upside Down Museum Penang" />
    <meta property="og:title" data-i18n="meta_og_title" data-ms={titleMs} data-en={titleEn} data-zh={titleZh} content={titleEn} />
    <meta property="og:description" data-i18n="meta_og_desc" data-ms={descMs} data-en={descEn} data-zh={descZh} content={descEn} />
    <meta property="og:locale" data-i18n="meta_og_locale" data-ms="ms_MY" data-en="en_US" data-zh="zh_CN" content="en_US" />
    {canonical && <meta property="og:url" content={canonical.toString()} />}
    {socialImage && <meta property="og:image" content={socialImage.toString()} />}
    {socialImage && <meta property="og:image:alt" content="Upside Down Museum Penang — blue inverted shophouse on Lebuh Kimberley, George Town" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" data-i18n="meta_twitter_title" data-ms={titleMs} data-en={titleEn} data-zh={titleZh} content={titleEn} />
    <meta name="twitter:description" data-i18n="meta_twitter_desc" data-ms={descMs} data-en={descEn} data-zh={descZh} content={descEn} />
    <title data-i18n="meta_title" data-ms={titleMs} data-en={titleEn} data-zh={titleZh}>{titleEn}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.svg" sizes="32x32" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16.svg" sizes="16x16" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Malayalam:wght@400;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var STORAGE_KEY = "ui_lang";
        var SUPPORTED = { ms: true, en: true, zh: true };
        var DEFAULT = "en";
        function currentLang() {
          try {
            var s = localStorage.getItem(STORAGE_KEY);
            if (s && SUPPORTED[s]) return s;
          } catch (e) {}
          try {
            var nav = (navigator.language || "").toLowerCase();
            if (nav.indexOf("zh") === 0) return "zh";
            if (nav.indexOf("ms") === 0 || nav.indexOf("id") === 0) return "ms";
            if (nav.indexOf("en") === 0) return "en";
          } catch (e) {}
          return DEFAULT;
        }
        function applyLang(lang) {
          if (!SUPPORTED[lang]) lang = DEFAULT;
          document.documentElement.setAttribute("lang", lang);
          document.documentElement.setAttribute("data-ui-lang", lang);
          var nodes = document.querySelectorAll("[data-i18n]");
          for (var i = 0; i < nodes.length; i++) {
            var el = nodes[i];
            var v = el.getAttribute("data-" + lang);
            if (v == null) continue;
            if (el.tagName === "META") {
              if (el.hasAttribute("content")) el.setAttribute("content", v);
            } else if (el.tagName === "TITLE") {
              el.textContent = v;
            } else if (el.hasAttribute("aria-label")) {
              el.setAttribute("aria-label", v);
            } else if (el.hasAttribute("alt")) {
              el.setAttribute("alt", v);
            } else if (el.hasAttribute("title")) {
              el.setAttribute("title", v);
            } else if (el.childElementCount === 0) {
              el.textContent = v;
            } else {
              var textNodes = [];
              for (var k = 0; k < el.childNodes.length; k++) {
                var child = el.childNodes[k];
                if (child.nodeType === Node.TEXT_NODE) textNodes.push(child);
              }
              if (textNodes.length === 1) {
                textNodes[0].nodeValue = v;
              }
            }
          }
          var switches = document.querySelectorAll("[data-lang-switch]");
          for (var j = 0; j < switches.length; j++) {
            var b = switches[j];
            var target = b.getAttribute("data-lang-switch");
            if (target === lang) b.classList.add("is-active");
            else b.classList.remove("is-active");
          }
          try {
            localStorage.setItem(STORAGE_KEY, lang);
          } catch (e) {}
        }
        function boot() {
          applyLang(currentLang());
          document.addEventListener("click", function (e) {
            var t = e.target;
            while (t && t.getAttribute && !t.getAttribute("data-lang-switch")) t = t.parentNode;
            if (!t) return;
            e.preventDefault();
            applyLang(t.getAttribute("data-lang-switch"));
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", boot);
        } else {
          boot();
        }
        window.__applyUiLang = applyLang;
      })();
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
